# PostgreSQL via Neon (obtenha em vercel.com/storage ou neon.tech)
# Use a pooled connection URL para DATABASE_URL e a direct URL para DIRECT_URL
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host/dbname?connect_timeout=15"
NEXT_PUBLIC_WHATSAPP_NUMBER="5541999866482"
# ADMIN_PASSWORD is required in production. Leave empty in development to skip auth.
# In production, if ADMIN_PASSWORD is unset, /admin/* returns HTTP 503.
ADMIN_USER="admin"
ADMIN_PASSWORD=""
# Override the Revenda Mais XML feed URL (optional — falls back to the hardcoded default)
REVENDAMAIS_XML_URL=""
