generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ConsignmentLead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String
  city        String
  brand       String
  model       String
  version     String?
  year        Int?
  mileage     Int?
  plate       String?
  color       String?
  askingPrice Float?
  notes       String?
  images      String   @default("[]")
  status      String   @default("pendente_avaliacao")
  createdAt   DateTime @default(now())
  vehicle     Vehicle?

  @@index([status])
  @@index([createdAt])
}

model Vehicle {
  id                String           @id
  consignmentLeadId String?          @unique
  title             String
  brand             String
  model             String
  version           String?
  year              Int?
  mileage           Int?
  price             Float?
  fuel              String?
  transmission      String?
  color             String?
  description       String?
  images            String           @default("[]")
  features          String           @default("[]")
  source            String           @default("consignment")
  createdAt         DateTime         @default(now())
  consignmentLead   ConsignmentLead? @relation(fields: [consignmentLeadId], references: [id], onDelete: SetNull)

  @@index([brand, model])
  @@index([createdAt])
}
